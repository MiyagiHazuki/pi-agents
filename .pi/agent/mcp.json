{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 90,
      "exposure": "codemode",
      "description": "Look up current library documentation and code examples using Context7."
    },
    "nano-pdf-mcp": {
      "command": "uvx",
      "args": ["nano-pdf-mcp"],
      "enabled": true,
      "timeout": 90,
      "exposure": "codemode"
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true,
      "timeout": 90,
      "exposure": "codemode"
    },
    "arxiv-mcp-server": {
      "command": "uvx",
      "args": ["--from", "arxiv-mcp-server", "arxiv-mcp-server"],
      "enabled": true,
      "timeout": 90,
      "exposure": "codemode"
    }
  }
}
